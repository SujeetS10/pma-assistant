# Copy to .env in this folder (never commit it).

# --- LLM provider (backend only; never sent to the browser) ---
# Default: Groq. Get a key at console.groq.com. Plain values, no quotes.
LLM_API_KEY=replace_with_your_groq_key
LLM_MODEL=openai/gpt-oss-120b
# Optional. Defaults to Groq. Other OpenAI-compatible providers, e.g.:
#   xAI:    https://api.x.ai/v1
#   OpenAI: https://api.openai.com/v1
# LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Admin account, created/updated on every start. Change the password by editing it and restarting. ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_password

# --- Retrieval (tune with the evaluation script) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Embeddings run locally on ONNX Runtime (no PyTorch). To use almost zero local memory instead, point at an
# OpenAI-compatible embeddings API (then set EMBEDDING_MODEL to that provider's model, and re-upload documents):
# EMBEDDING_PROVIDER=api
# EMBEDDING_API_KEY=...
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# MODEL_CACHE_DIR=./.model_cache
TOP_K=8
MAX_CONTEXT_CHUNKS=5
MIN_SCORE=0.30
CHUNK_CHARS=1200

# --- Server ---
# All persistent state (database, uploads, vectors) lives here. Back this folder up.
# DATA_DIR=./data
SESSION_HOURS=12
MAX_UPLOAD_MB=20
# Set true when served over HTTPS (cookies are then marked Secure).
COOKIE_SECURE=false
